{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "PORT": "8000"
  },
  "crons": [
    {
      "path": "/api/v1/cron/sync-all-feeds",
      "schedule": "0 * * * *"
    }
  ]
}
