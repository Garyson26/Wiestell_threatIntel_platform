{
  "version": 2,
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "env": {
    "PORT": "8000"
  },
  "crons": [
    {
      "path": "/api/v1/feeds/sync-all?force=true&enrich=true&enrich_limit=100", // STEP 1: FEED SYNCHRONIZATION
      "schedule": "0 0 * * *"
    }
  ]
}
