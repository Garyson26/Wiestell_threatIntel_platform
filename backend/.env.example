# Database Configuration
DATABASE_URL=mysql+pymysql://user:password@host/database
DATABASE_ASYNC_URL=mysql+aiomysql://user:password@host/database

# Redis (Optional - not available on Vercel serverless)
REDIS_URL=redis://localhost:6379

# Threat Intelligence API Keys (all optional)
OTX_API_KEY=9a5f6f43989519255d63c124e53f84a07d62de847939454bdf0d9998a0ae58a7
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
VT_API_KEY=5eaa9648287078af5e1cf116458ad4f0b6848af3e15b5c96866b7055948cab16
SHODAN_API_KEY=your_shodan_api_key_here
PHISHTANK_API_KEY=your_phishtank_api_key_here

# AI Configuration
GROQ_API_KEY=your_groq_api_key_here

# Application Configuration
SECRET_KEY=generate_a_secure_random_key_here
ENVIRONMENT=production
LOG_LEVEL=INFO
FEED_SYNC_INTERVAL=3600
PORT=8000

# CORS Configuration - SECURITY CRITICAL
# Use specific domains only, never use "*" in production
# Comma-separated list of allowed origins
CORS_ORIGINS=https://wiestell.com,https://www.wiestell.com

# GeoIP Database
GEOIP_DB_PATH=/app/data/GeoLite2-City.mmdb

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# Cache TTLs (seconds)
CACHE_TTL_WHOIS=86400
CACHE_TTL_DNS=3600
CACHE_TTL_GEOIP=86400
CACHE_TTL_REPUTATION=21600
CACHE_TTL_DASHBOARD=60

# Email Configuration
EMAIL_SERVICE=smtp
EMAIL_USER=noreply@wiestell.com
EMAIL_PASSWORD=your_email_password_here
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
