# ─────────────────────────────────────────────────────────────────────────────
# Wiestell TIP — example environment file
#
# Copy to .env and fill in real values. .env is git-ignored; NEVER commit
# credentials to this file or to docker-compose.yml / render.yaml.
# ─────────────────────────────────────────────────────────────────────────────

# Database (required) — driver+dialect must match the deployment
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST/DATABASE
DATABASE_ASYNC_URL=mysql+aiomysql://USER:PASSWORD@HOST/DATABASE

# Redis — OPTIONAL, and currently unused in production.
#
# utils/rate_limiter uses Redis when REDIS_URL is set and falls back to a process-local
# dict when it is not. That fallback is CORRECT on the current deployment, which runs one
# uvicorn worker on a single Render instance, so the Render blueprint deliberately does not
# provision Redis (see the note in render.yaml).
#
# Set this when EITHER becomes true: the worker count is raised above 1, or more than one
# instance runs. At that point the in-memory limiter becomes N independent budgets and the
# effective rate limit is N x AUTH_RATE_LIMIT_MAX. Celery also needs it as a broker if the
# beat schedule is ever enabled.
REDIS_URL=redis://redis:6379/0

# Security (required) — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Shared secret for scheduler-triggered maintenance endpoints
# (POST /api/v1/feeds/sync-all, POST /api/v1/enrichment/backfill/start).
# Send it as the X-Cron-Secret header.
CRON_SECRET=

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
FEED_SYNC_INTERVAL=3600

# Comma-separated list of allowed browser origins. Never use "*" — the API
# sends credentials, so a wildcard would let any site read authenticated data.
CORS_ORIGINS=http://localhost:3000

# Serve /docs, /redoc and /openapi.json (keep false in production)
ENABLE_API_DOCS=false

# Email (required for OTP delivery — without it NOBODY CAN LOG IN)
#
# Transport is the Resend HTTP API over 443. SMTP was removed in Phase 3: Render free web
# services cannot open outbound connections on 25/465/587, and the auth flow is
# password -> email OTP -> JWT. Resend's SMTP on 2465/2587 is not blocked by Render but was
# rejected — see utils/email_service.py for why.
#
# The key needs SENDING access only. RESEND_API_KEY must NEVER be added to
# ALLOWED_FEED_API_KEY_ENVS in config.py.
RESEND_API_KEY=
EMAIL_FROM=Wiestell <noreply@wiestell.com>

# Error alert emails carry redacted request context — opt in deliberately
ADMIN_EMAIL=
ENABLE_ERROR_EMAILS=false

# ── Threat feed / enrichment API keys ────────────────────────────────────────
# OTX and AbuseIPDB gate their own feeds entirely (no key -> that feed cannot sync).
OTX_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=

# abuse.ch: ONE Auth-Key from https://auth.abuse.ch/ covers URLhaus, ThreatFox,
# MalwareBazaar and YARAify. The code reads separate variable names rather than one
# shared name, so paste the SAME value into each of the four below. (YARAIFY_API_KEY
# is the only one with an automatic fallback — it uses MALWAREBAZAAR_API_KEY.)
#
# Verified 2026-07-30: abuse.ch CSV/download exports are still open, but its JSON
# query APIs return 401 Unauthorized. Consequences of leaving these blank:
#   URLhaus       - still ingests URL IOCs from the open CSVs; loses the keyed
#                   hash and domain exports
#   ThreatFox     - still ingests from the open CSV exports; the query API is 401
#   MalwareBazaar - FEED has no keyless path in this codebase, and the ENRICHER is
#                   not registered at all (it would otherwise write a 401 error row
#                   against every hash IOC)
#   YARAify       - enricher not registered
MALWAREBAZAAR_API_KEY=
THREATFOX_API_KEY=
URLHAUS_API_KEY=

# Vulnerability / malware enrichment
# NVD: optional — unauthenticated is 5 req/30s, a key raises it to 50 req/30s
NVD_API_KEY=
# YARAify: abuse.ch Auth-Key. Falls back to MALWAREBAZAAR_API_KEY if unset.
YARAIFY_API_KEY=
# CVE Details: paid subscription. The enricher is skipped entirely when unset.
CVEDETAILS_ACCESS_TOKEN=

# AI (Groq)
GROQ_API_KEY=
